{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Madrid",
  "packageRules": [
    {
      "description": "OpenNext pins the Next.js range it supports: they are updated together (stack.md §18).",
      "matchPackageNames": ["next", "@opennextjs/cloudflare"],
      "groupName": "next + opennext"
    },
    {
      "description": "Wrangler, workers-types and the Workers test plugin go hand in hand.",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types", "@cloudflare/vitest-plugin"],
      "groupName": "cloudflare tooling"
    }
  ]
}
