{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paddock-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // No public routes: Cron Triggers only (security.md §14).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *", "0 4 * * *", "0 5 * * 1", "0 8 * * 2"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paddock-db",
      "database_id": "8bd68b75-62c1-4b01-9801-38f7e683bde3",
      // wrangler dev keeps its local SQLite under this id: the local data survives the real id above.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OUTBOUND_LIMITER", "class_name": "OutboundLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OutboundLimiter"] }],
  "workflows": [
    { "name": "paddock-backfill", "binding": "BACKFILL", "class_name": "BackfillWorkflow" },
    { "name": "paddock-post-race", "binding": "POST_RACE", "class_name": "PostRaceWorkflow" },
    { "name": "paddock-mailing", "binding": "MAILING", "class_name": "MailingWorkflow" }
  ],
  // The post-race JSON in KV, not R2, to stay on the free plan (D-39).
  "kv_namespaces": [{ "binding": "ANALYSIS", "id": "8433eb186ecd4f1d82f0f4161bb104f4", "preview_id": "paddock-analysis-local" }],
  "vars": {
    "SITE_URL": "https://paddock-web.marcmendezb.workers.dev",
    "EMAIL_FROM": "Paddock Notes <hola@paddocknotes.dev>",
    // Pending: the controller's postal address for the newsletter footer.
    "MAIL_POSTAL_ADDRESS": "",
    "JOLPICA_BASE_URL": "https://api.jolpi.ca/ergast/f1",
    "JOLPICA_MAX_PER_SECOND": "1",
    "JOLPICA_MAX_PER_HOUR": "400",
    "JOLPICA_BACKFILL_MAX_PER_HOUR": "300",
    "OPENF1_BASE_URL": "https://api.openf1.org/v1",
    "OPENF1_MAX_PER_SECOND": "2",
    "OPENF1_MAX_PER_MINUTE": "25",
    // No lap-by-lap history: nothing reads it, and ~700,000 rows exceed the free plan's D1 writes (D-39).
    "BACKFILL_LAPS": "false"
  },
  "env": {
    "preview": {
      "name": "paddock-ingest-preview",
      // No crons: the free plan allows five per account and production uses four (D-39). Preview data is
      // loaded by hand from the dashboard when a pull request needs it.
      "triggers": { "crons": [] },
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "paddock-db-preview",
          "database_id": "2466983f-5be1-42aa-8c11-9d8d29a64e7e",
          // wrangler dev keeps its local SQLite under this id: the local data survives the real id above.
          "preview_database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "OUTBOUND_LIMITER", "class_name": "OutboundLimiter" }]
      },
      "workflows": [
        { "name": "paddock-backfill-preview", "binding": "BACKFILL", "class_name": "BackfillWorkflow" },
        { "name": "paddock-post-race-preview", "binding": "POST_RACE", "class_name": "PostRaceWorkflow" },
        { "name": "paddock-mailing-preview", "binding": "MAILING", "class_name": "MailingWorkflow" }
      ],
      "kv_namespaces": [{ "binding": "ANALYSIS", "id": "84abdf293f7143689b80e6bffaad1207", "preview_id": "paddock-analysis-local" }],
      "vars": {
        "SITE_URL": "https://paddock-web-preview.marcmendezb.workers.dev",
        "EMAIL_FROM": "Paddock Notes <hola@paddocknotes.dev>",
        "MAIL_POSTAL_ADDRESS": "",
        "JOLPICA_BASE_URL": "https://api.jolpi.ca/ergast/f1",
        "JOLPICA_MAX_PER_SECOND": "1",
        "JOLPICA_MAX_PER_HOUR": "400",
        "JOLPICA_BACKFILL_MAX_PER_HOUR": "300",
        "OPENF1_BASE_URL": "https://api.openf1.org/v1",
        "OPENF1_MAX_PER_SECOND": "2",
        "OPENF1_MAX_PER_MINUTE": "25",
        "BACKFILL_LAPS": "false"
      }
    }
  }
}
