{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paddock-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 50 },
  // No public host until the custom domain (D-38): the web app reaches it over the Service Binding and
  // proxies /api/* for browsers and email links (D-26).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paddock-db",
      "database_id": "8bd68b75-62c1-4b01-9801-38f7e683bde3",
      // wrangler dev keeps its local SQLite under this id: the local data survives the real id above.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "3706284051af40d8aae5e0eb93bc316c" }],
  "r2_buckets": [{ "binding": "ANALYSIS", "bucket_name": "paddock-analysis", "jurisdiction": "eu" }],
  "ratelimits": [
    { "name": "RATE_LIMIT_READ", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_WRITE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  // No Email Service binding: the project sends no email (D-38).
  // AUTH_SECRET, TURNSTILE_SECRET and the OAuth credentials go in with `wrangler secret put` (security.md §11).
  "vars": {
    "SITE_URL": "https://paddock-web.marcmendezb.workers.dev",
    "AUTH_BASE_URL": "https://paddock-web.marcmendezb.workers.dev",
    "TRUSTED_ORIGINS": "https://paddock-web.marcmendezb.workers.dev",
    "EMAIL_FROM": "Paddock Notes <hola@paddocknotes.dev>"
  },
  "env": {
    "preview": {
      "name": "paddock-api-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "paddock-db-preview",
          "database_id": "2466983f-5be1-42aa-8c11-9d8d29a64e7e",
          // wrangler dev keeps its local SQLite under this id: the local data survives the real id above.
          "preview_database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "ed9e1f4c70a3403881feb00b5409a8e6" }],
      "r2_buckets": [{ "binding": "ANALYSIS", "bucket_name": "paddock-analysis-preview", "jurisdiction": "eu" }],
      "ratelimits": [
        { "name": "RATE_LIMIT_READ", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMIT_WRITE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "SITE_URL": "https://paddock-web-preview.marcmendezb.workers.dev",
        "AUTH_BASE_URL": "https://paddock-web-preview.marcmendezb.workers.dev",
        "TRUSTED_ORIGINS": "https://paddock-web-preview.marcmendezb.workers.dev",
        "EMAIL_FROM": "Paddock Notes <hola@paddocknotes.dev>"
      }
    }
  }
}
